# ─── Databases (MongoDB) ───────────────────────────────────────────────────────
DB_USERNAME=changeme
DB_PASSWORD=changeme
USERS_DB_NAME=users_buy01
PRODUCTS_DB_NAME=products_buy01
MEDIA_DB_NAME=media_buy01

JWT_SECRET=changeme
JWT_EXPIRATION=3600000

USER_DB_URI=mongodb://changeme:changeme@users-mongodb:27017/users_buy01?authSource=admin
PRODUCT_DB_URI=mongodb://changeme:changeme@products-mongodb:27017/products_buy01?authSource=admin
MEDIA_DB_URI=mongodb://changeme:changeme@media-mongodb:27017/media_buy01?authSource=admin

# ─── SSL (Gateway HTTPS) ───────────────────────────────────────────────────────
# Password used to generate keystore.p12 via scripts/create_Self-Signed-Certificate.sh
SSL_KEYSTORE_PASSWORD=changeme

# ─── Cloudflare R2 (Media Service) ────────────────────────────────────────────
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
R2_BUCKET=buy01
R2_ENDPOINT=changeme
R2_PUBLIC_URL=changeme

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGIN=https://localhost:4200

# ─── Jenkins ───────────────────────────────────────────────────────────────────
JENKINS_ADMIN_USERNAME=admin
JENKINS_ADMIN_PASSWORD=changeme
JENKINS_URL=http://localhost:8080/
USER_ID=1000

# GitHub token needs: repo (checkout + status) + admin:repo_hook (JCasC auto webhook registration)
GITHUB_USERNAME=changeme
GITHUB_TOKEN=changeme

# JNLP secrets for the backend-slave/frontend-slave agents — do NOT set these by
# hand: run `scripts/run.sh`, it reads the real value straight from the running
# Jenkins controller and writes it here for you.
BACKEND_SLAVE_SECRET=
FRONTEND_SLAVE_SECRET=

# ─── SMTP (Jenkins build notifications) ───────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=changeme
SMTP_PASSWORD=changeme

# ─── SonarQube ─────────────────────────────────────────────────────────────────
SONARQUBE_DB_NAME=sonarqube
SONARQUBE_DB_USERNAME=sonarqube
SONARQUBE_DB_PASSWORD=changeme

# Global analysis token — Administration > Security > Users > (admin) > Tokens,
# with Type = "Global Analysis Token". Used by the Jenkinsfile's
# withSonarQubeEnv() to run the scanner.
#
# NOT a project analysis token: the pipeline analyses one project per service
# (buy01-discovery, buy01-gateway, buy01-media, buy01-product, buy01-user,
# buy01-frontend), and a project token is bound to a single project key — every
# other key fails with "You're not authorized to run analysis". A global token
# also auto-provisions those six projects on their first analysis.
SONARQUBE_TOKEN=changeme

# Admin user token — same screen, Type = "User Token", on a user holding the
# global "Administer System" permission. Used only by
# scripts/provision-sonar-webhook.sh, which calls /api/webhooks/*; those
# endpoints reject analysis tokens with 403, so this must be a *different*
# token from SONARQUBE_TOKEN above.
SONARQUBE_ADMIN_TOKEN=changeme

# Password of that admin user — the one you set when SonarQube forced a change
# away from admin/admin on first login. Only read by
# scripts/provision-sonar-tokens.sh, which uses it to mint the two tokens above
# via /api/user_tokens/generate; leave it blank and that script prompts instead.
SONARQUBE_ADMIN_PASSWORD=changeme

# Shared secret validating the SonarQube -> Jenkins webhook payload; must match
# on both sides (Jenkins JCasC installations[].webhookSecretId and the webhook
# reconciled by scripts/provision-sonar-webhook.sh).
#
# Generate with:  openssl rand -hex 32
# Must be non-empty — the provisioner container aborts on a blank value, and a
# blank Jenkins-side credential makes waitForQualityGate drop the callback and
# hang until its timeout.
SONARQUBE_WEBHOOK_SECRET=changeme

# Browser-facing SonarQube address, for humans and for host-side scripts.
# The pipeline does NOT read this: withSonarQubeEnv() supplies the URL from the
# JCasC installation (http://sonarqube:9000), which is what the build agents
# need. docker-compose.jenkins.yml pins SONAR_HOST_URL on both agents so this
# host-only value cannot leak into a container and send it to itself.
SONAR_HOST_URL=http://localhost:9000

NGROK_TOKEN=changeme
