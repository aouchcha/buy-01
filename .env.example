# ─── MongoDB credentials ───────────────────────────────────────────────────────
# IMPORTANT: If you change DB_USERNAME or DB_PASSWORD,
#            update USER_DB_URI and PRODUCT_DB_URI accordingly.
DB_USERNAME=admin
DB_PASSWORD=changeme

USERS_DB_NAME=users_buy01
PRODUCTS_DB_NAME=products_buy01

# URIs — hostname = docker-compose service name (users-mongodb / products-mongodb)
USER_DB_URI=mongodb://admin:changeme@users-mongodb:27017/users_buy01?authSource=admin
PRODUCT_DB_URI=mongodb://admin:changeme@products-mongodb:27017/products_buy01?authSource=admin

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters (HMAC-SHA256)
JWT_SECRET=changeme_at_least_32_characters_long
JWT_EXPIRATION=3600000

# ─── SSL (Gateway HTTPS) ───────────────────────────────────────────────────────
# Password used to generate keystore.p12 via scripts/create_Self-Signed-Certificate.sh
SSL_KEYSTORE_PASSWORD=buy01pass

# ─── Cloudflare R2 (Media Service) ────────────────────────────────────────────
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
R2_BUCKET=buy01
R2_ENDPOINT=changeme
R2_PUBLIC_URL=changeme

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGIN=https://localhost:4200
